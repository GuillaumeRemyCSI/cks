# Copier en training/classroom.env puis adapter.

# Fork public contenant les adaptations (Ubuntu 24.04, Kubernetes 1.35.2).
# Les VMs y téléchargent au démarrage leurs scripts et les tests de check_result.
CKS_REPO="<votre-compte-github>/cks"
CKS_REPO_REF="formation-lfs460"

# IP publique de la salle de formation (séparer plusieurs CIDR par des virgules).
# Laisser vide pour ouvrir SSH à tout Internet (accès par mot de passe).
CKS_ACCESS_CIDRS=""

# Nombre de participants déployés en même temps.
PARALLEL=4

PARTICIPANTS_FILE="training/participants.txt"
