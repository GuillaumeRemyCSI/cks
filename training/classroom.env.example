# Copy to training/classroom.env, then adapt.

# Cloud: "aws" (default) or "gcp".
CKS_CLOUD="gcp"

# Google Cloud only: project, Terraform state bucket (globally unique name, created by
# classroom.sh up if missing), region and zone of the VMs. Use a region allowed by your
# organization's resource location policy (constraints/gcp.resourceLocations).
CKS_GCP_PROJECT="<project-id>"
CKS_GCP_STATE_BUCKET="<project-id>-cks-tfstate"
CKS_GCP_REGION="europe-west1"
CKS_GCP_ZONE="europe-west1-b"

# Public fork with the adaptations (Ubuntu 24.04, Kubernetes 1.35.2).
# The VMs download their scripts and the check_result tests from it at boot.
CKS_REPO="<your-github-account>/cks"
CKS_REPO_REF="formation-lfs460"

# Public IPv4 of the training room (separate several CIDRs with commas).
# Leave empty to open SSH to the whole Internet (password access).
CKS_ACCESS_CIDRS=""

# Number of participants deployed at the same time.
PARALLEL=4

PARTICIPANTS_FILE="training/participants.txt"  # relative to the repository root
